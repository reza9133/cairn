# Copy to .env (or export these in the shell). `npm run keys` can create the file for you.
# Never commit real keys. In a GitHub Codespace, store them as Codespaces secrets with the same names.

# Required: three different accounts funded on Studionet.
# The organizer needs about 0.05 GEN (it only pays for transactions and never stakes).
# Alice and Bob each need about 0.1 GEN (they stake in the test pools and post contest bonds).
ORGANIZER_KEY=0x
ALICE_KEY=0x
BOB_KEY=0x

# Optional: a third member. Without it a fresh account is funded through the simulator
# and the arena scenario is skipped when that is not possible.
CAROL_KEY=

# Optional: a referee and an outsider (random accounts are used when empty; the referee is funded through the
# simulator when it holds nothing, the outsider only ever sends unpaid calls).
REFEREE_KEY=
OUTSIDER_KEY=

# Optional: use an existing deployment instead of deploying contracts/cairn.py first.
CAIRN_ADDRESS=

# Optional tuning
# REPORT_DIR=reports
